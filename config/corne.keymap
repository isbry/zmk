#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors.dtsi>

#define DEFAULT 0
#define NAV     1
#define NUM     2
#define SYM     3
#define FUNC    4
#define WM      5

#define LEFT_KEYS   0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define RIGHT_KEYS  5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMB_KEYS  30 31 32 33 34 35

#define MAC_UNDO  LG(Z)
#define MAC_REDO  LG(LS(Z))
#define MAC_CUT   LG(X)
#define MAC_COPY  LG(C)
#define MAC_PASTE LG(V)

/ {
  chosen {
    zmk,physical-layout = &foostan_corne_5col_layout;
  };

  behaviors {
    hml: homerow_mods_left {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      hold-trigger-key-positions = <RIGHT_KEYS THUMB_KEYS>;
      hold-trigger-on-release;
      bindings = <&kp>, <&kp>;
    };

    hmr: homerow_mods_right {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      hold-trigger-key-positions = <LEFT_KEYS THUMB_KEYS>;
      hold-trigger-on-release;
      bindings = <&kp>, <&kp>;
    };

    wmod: wm_modifier {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <200>;
      bindings = <&kp>, <&kp>;
    };

    thumb: thumb_layer_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <200>;
      quick-tap-ms = <175>;
      bindings = <&mo>, <&kp>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp Q          &kp W          &kp E           &kp R           &kp T            &kp Y           &kp U           &kp I           &kp O          &kp P
        &hml LGUI A    &hml LALT S    &hml LCTRL D    &hml LSHIFT F   &kp G            &kp H           &hmr RSHIFT J   &hmr RCTRL K    &hmr RALT L    &hmr RGUI SEMI
        &kp Z          &kp X          &kp C           &kp V           &kp B            &kp N           &kp M           &kp COMMA       &kp DOT        &kp FSLH
                                      &thumb WM ESC   &thumb NAV SPACE &thumb NUM TAB  &thumb SYM RET  &kp BSPC        &thumb FUNC DEL
      >;
    };

    nav_layer {
      display-name = "Nav";
      bindings = <
        &none          &none          &none           &none           &none            &kp MAC_REDO    &kp MAC_PASTE   &kp MAC_COPY    &kp MAC_CUT    &kp MAC_UNDO
        &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHIFT      &none            &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT      &caps_word
        &none          &none          &none           &none           &none            &kp HOME        &kp PG_DN       &kp PG_UP       &kp END        &kp INS
                                      &trans          &trans          &trans           &trans          &trans          &trans
      >;
    };

    num_layer {
      display-name = "Num";
      bindings = <
        &none          &none          &none           &none           &none            &kp FSLH        &kp N7          &kp N8          &kp N9         &kp STAR
        &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHIFT      &none            &kp MINUS       &kp N4          &kp N5          &kp N6         &kp PLUS
        &none          &none          &none           &none           &none            &kp N0          &kp N1          &kp N2          &kp N3         &kp DOT
                                      &trans          &trans          &trans           &kp EQUAL       &trans          &trans
      >;
    };

    sym_layer {
      display-name = "Sym";
      bindings = <
        &kp EXCL       &kp AT         &kp LBKT        &kp RBKT        &kp PIPE         &kp AMPS        &kp STAR        &kp LT          &kp GT         &kp BSLH
        &kp HASH       &kp DLLR       &kp LPAR        &kp RPAR        &kp GRAVE        &none           &kp RSHIFT      &kp RCTRL       &kp RALT       &kp RGUI
        &kp PRCNT      &kp CARET      &kp LBRC        &kp RBRC        &kp TILDE        &kp UNDER       &kp EQUAL       &kp PLUS        &kp DQT        &kp COLON
                                      &trans          &kp MINUS       &kp SQT          &trans          &trans          &trans
      >;
    };

    func_layer {
      display-name = "Func";
      bindings = <
        &kp F12        &kp F7         &kp F8          &kp F9          &none            &none           &none           &kp C_BRI_DN    &kp C_BRI_UP   &none
        &kp F11        &kp F4         &kp F5          &kp F6          &none            &none           &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP   &kp C_NEXT
        &kp F10        &kp F1         &kp F2          &kp F3          &none            &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_NXT     &bt BT_CLR
                                      &kp C_MUTE      &kp C_PP        &kp C_STOP       &trans          &trans          &trans
      >;
    };

    wm_layer {
      display-name = "WM";
      bindings = <
        &kp LA(Q)      &kp LA(W)      &kp LA(E)       &kp LA(R)       &kp LA(T)        &kp LA(Y)       &none           &kp LA(I)       &kp LA(O)      &kp LA(P)
        &kp LA(A)      &kp LA(S)      &wmod LCTRL LA(D) &wmod LSHIFT LA(F) &none       &kp LA(H)       &kp LA(J)       &kp LA(K)       &kp LA(L)      &kp LS(LA(N0))
        &kp LA(Z)      &kp LA(X)      &none           &none           &kp LA(B)        &kp LA(N)       &kp LA(N1)      &kp LA(N2)      &kp LA(N3)     &kp LA(N4)
                                      &trans          &kp LA(SPACE)   &kp LA(TAB)      &kp LA(RET)     &kp LA(GRAVE)   &none
      >;
    };
  };
};
